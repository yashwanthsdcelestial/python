{
  "info": {
    "name": "Online Exam Management System",
    "description": "Complete API collection for the Online Exam Management System.\n\nWorkflow:\n1. Register or Login to get tokens\n2. Set `access_token` variable from login response\n3. Use role-specific endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "exam_id", "value": "1", "type": "string" },
    { "key": "attempt_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": { "method": "GET", "url": "{{base_url}}/", "description": "Health check" }
        },
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{base_url}}/health" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has id', () => pm.expect(pm.response.json().id).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newstudent@example.com\",\n  \"password\": \"Student@1234\",\n  \"full_name\": \"New Student\",\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "Register (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newadmin@example.com\",\n  \"password\": \"Admin@1234\",\n  \"full_name\": \"New Admin\",\n  \"role\": \"admin\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "pm.test('Has access_token', () => pm.expect(json.access_token).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@examportal.com\",\n  \"password\": \"Admin@1234\"\n}"
            }
          }
        },
        {
          "name": "Login (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "pm.collectionVariables.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@example.com\",\n  \"password\": \"Student@1234\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Exams",
      "item": [
        {
          "name": "List Exams",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/exams?page=1&page_size=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "sort_by", "value": "created_at", "disabled": true },
                { "key": "sort_desc", "value": "true", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Get Exam by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/exams/{{exam_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Exam (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('exam_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/exams",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"JavaScript Basics\",\n  \"description\": \"Test your JS knowledge\",\n  \"duration_minutes\": 30,\n  \"pass_percentage\": 60.0,\n  \"max_attempts\": 2,\n  \"questions\": [\n    {\n      \"text\": \"Which keyword declares a variable in modern JS?\",\n      \"options\": [\"var\", \"let\", \"const\", \"Both let and const\"],\n      \"correct_answer\": \"Both let and const\",\n      \"marks\": 10\n    },\n    {\n      \"text\": \"What does === check?\",\n      \"options\": [\"Value only\", \"Type only\", \"Value and type\", \"Reference\"],\n      \"correct_answer\": \"Value and type\",\n      \"marks\": 10\n    },\n    {\n      \"text\": \"Which method converts JSON string to object?\",\n      \"options\": [\"JSON.parse()\", \"JSON.stringify()\", \"JSON.convert()\", \"JSON.decode()\"],\n      \"correct_answer\": \"JSON.parse()\",\n      \"marks\": 10\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update Exam (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/exams/{{exam_id}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\",\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Delete Exam (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/exams/{{exam_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll in Exam (Student)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/enrollments/{{exam_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "My Enrolled Exams (Student)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/enrollments?page=1&page_size=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Attempts",
      "item": [
        {
          "name": "Start Attempt (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('attempt_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/attempts/start/{{exam_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Submit Attempt (Student)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/attempts/{{attempt_id}}/submit",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    { \"question_id\": 1, \"selected_answer\": \"<class 'list'>\" },\n    { \"question_id\": 2, \"selected_answer\": \"def\" },\n    { \"question_id\": 3, \"selected_answer\": \"3\" },\n    { \"question_id\": 4, \"selected_answer\": \"tuple\" },\n    { \"question_id\": 5, \"selected_answer\": \"8\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "My Results (Student)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/attempts/my-results?page=1&page_size=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Get Attempt Detail (Student)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/attempts/{{attempt_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/admin/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "List Users (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/admin/users?page=1&page_size=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "role", "value": "student", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Deactivate User (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/admin/users/3/deactivate",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Exam Results (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/admin/exam-results/{{exam_id}}?page=1&page_size=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Student Exam Summary View (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/admin/view/student-exam-summary",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}
