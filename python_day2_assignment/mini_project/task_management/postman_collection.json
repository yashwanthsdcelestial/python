{
  "info": {
    "name": "Day2-TaskAPI",
    "description": "FastAPI Task Management System collection for Postman testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@mail.com\",\n  \"password\": \"securepass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/users/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "register"]
            },
            "description": "Register a new user | Expected: 201 Created"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"securepass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/users/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "login"]
            },
            "description": "Login user with credentials | Expected: 200 OK"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users"]
            },
            "description": "List all users | Expected: 200 OK"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:8000/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "1"]
            },
            "description": "Delete user by ID | Expected: 200 OK"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write report\",\n  \"description\": \"Q2 summary report\",\n  \"priority\": \"high\",\n  \"status\": \"pending\",\n  \"owner\": \"alice\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/tasks",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks"]
            },
            "description": "Create a new task | Expected: 201 Created"
          }
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/tasks?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "List all tasks with pagination | Expected: 200 OK"
          }
        },
        {
          "name": "List Tasks with Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/tasks?status=pending&priority=high&owner=alice&page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "priority",
                  "value": "high"
                },
                {
                  "key": "owner",
                  "value": "alice"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "List tasks with filters and pagination | Expected: 200 OK"
          }
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/tasks/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks", "1"]
            },
            "description": "Get task by ID | Expected: 200 OK"
          }
        },
        {
          "name": "Update Task (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"description\": \"Updated description\",\n  \"priority\": \"medium\",\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/tasks/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks", "1"]
            },
            "description": "Full update of task | Expected: 200 OK"
          }
        },
        {
          "name": "Partial Update Task (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/tasks/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks", "1"]
            },
            "description": "Partial update of task | Expected: 200 OK"
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:8000/tasks/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks", "1"]
            },
            "description": "Delete task by ID | Expected: 200 OK"
          }
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Duplicate User Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice2@mail.com\",\n  \"password\": \"securepass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/users/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "register"]
            },
            "description": "Try to register with duplicate username | Expected: 409 Conflict"
          }
        },
        {
          "name": "Invalid Credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/users/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "login"]
            },
            "description": "Login with wrong password | Expected: 401 Unauthorized"
          }
        },
        {
          "name": "User Not Found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/users/999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "999"]
            },
            "description": "Get non-existent user | Expected: 404 Not Found"
          }
        },
        {
          "name": "Task Not Found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/tasks/999",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["tasks", "999"]
            },
            "description": "Get non-existent task | Expected: 404 Not Found"
          }
        },
        {
          "name": "Invalid Email Format",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"charlie\",\n  \"email\": \"invalid-email\",\n  \"password\": \"securepass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/users/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "register"]
            },
            "description": "Register with invalid email | Expected: 422 Unprocessable Entity"
          }
        },
        {
          "name": "Short Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"diana\",\n  \"email\": \"diana@mail.com\",\n  \"password\": \"short\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/users/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["users", "register"]
            },
            "description": "Register with password < 8 chars | Expected: 422 Unprocessable Entity"
          }
        }
      ]
    }
  ]
}
